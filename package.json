{
  "name": "velotrap",
  "version": "3.1.21",
  "description": "Velotrap - High-Speed Multi-Threaded Download Manager & Universal Video/Audio Grabber",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "bump": "node scripts/bump-version.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:vite": "vite build",
    "build": "npm run bump && npm run build:electron && npm run build:vite",
    "package:mac": "npm run build && node scripts/package-macos.mjs",
    "start": "npm run build && ./node_modules/electron/dist/Velotrap.app/Contents/MacOS/Velotrap .",
    "test": "node --test tests/engine.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}

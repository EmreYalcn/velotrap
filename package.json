{
  "name": "velotrap",
  "version": "3.1.11",
  "description": "Velotrap - High-Speed Multi-Threaded Download Manager & Universal Video/Audio Grabber",
  "main": "dist-electron/main.js",
  "author": "Velotrap Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/velotrap/velotrap.git"
  },
  "bugs": {
    "url": "https://github.com/velotrap/velotrap/issues"
  },
  "homepage": "https://github.com/velotrap/velotrap#readme",
  "keywords": [
    "download-manager",
    "idm-alternative",
    "video-downloader",
    "mp3-converter",
    "electron",
    "react",
    "hls-downloader",
    "m3u8",
    "chrome-extension",
    "multi-threaded-downloads",
    "ffmpeg",
    "yt-dlp",
    "macos",
    "open-source"
  ],
  "scripts": {
    "dev:vite": "vite",
    "bump": "node scripts/bump-version.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:vite": "vite build",
    "build": "npm run bump && npm run build:electron && npm run build:vite",
    "package:mac": "npm run build && node scripts/package-macos.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/engine.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
